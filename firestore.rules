rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Official announcements & bulletins (Grades 9-12 community feed)
    match /official_announcements/{document} {
      allow read, write: if true;
    }

    // Broadcast notifications (Alerts, updates, model exam notifications)
    match /broadcast_notifications/{document} {
      allow read, write: if true;
    }

    // Device push tokens for FCM notifications
    match /device_push_tokens/{document} {
      allow read, write: if true;
    }

    // Catch-all fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
